{
  "services": [
    {
      "name": "DrissionPageService",
      "module": "backend_infrastructure",
      "path": "backend/app/infrastructure/automation/drission_page.py",
      "methods": ["run_login"],
      "callers": ["app.presentation.api.run_account_login"]
    },
    {
      "name": "PlaywrightService",
      "module": "backend_infrastructure",
      "path": "backend/app/infrastructure/automation/playwright_service.py",
      "methods": ["run_login"],
      "callers": ["app.presentation.api.run_account_login"]
    },
    {
      "name": "API Client",
      "module": "frontend",
      "path": "frontend/src/services/api.js",
      "methods": ["fetchAccounts", "createAccount", "updateAccount", "deleteAccount", "streamLoginLogs", "fetchHistory"],
      "callers": ["Vue components"]
    }
  ]
}
